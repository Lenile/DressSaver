<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!--
    Si GitHub Actions échoue avec une erreur de version de SDK, remplacez 15.0.0
    par la version actuelle de Dalamud.NET.Sdk (voir nuget.org/packages/Dalamud.NET.Sdk).
  -->
  <PropertyGroup>
    <Version>0.5.3.0</Version>
    <Description>Saves your character's current outfit as a clean Penumbra mod, with its Glamourer design.</Description>
    <PackageProjectUrl>https://github.com/Lenile/DressSaver</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Penumbra.Api" Version="5.*" />
    <PackageReference Include="Glamourer.Api" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
